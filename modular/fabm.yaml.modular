instances:
  # ==================================
  # this has to appear at the very top
  switches:
    model: nersc/ecosmo_shared
    parameters:
      couple_co2 : true
#      use_chl: true
#      use_chl_in_PI_curve: true
      light_att_chl: 0.04
#      use_calcifier : false
  # this has to appear at the very top
  # ==================================

  light:
    model: gotm/light
    parameters:
       g2         : 20.0 #23.0     # e-folding depth of visible fraction  (m)                     default=23.0
       g1         : 0.35
       A          : 0.6 #0.58

  co2:
    model: ersem/carbonate
    initialization:
      TA: 2300.0
      c: 2200.0

  no3:
    long_name: nitrate
    model: nersc/ecosmo_nutrient
    initialization:
      c: 1200.0     # nitrate (mgC/m**3)
  pho:
    long_name: phosphate
    model: nersc/ecosmo_nutrient
    initialization:
      c: 1200.0     # phosphate (mgC/m**3)

  sil:
    long_name: silicate
    model: nersc/ecosmo_nutrient
    initialization:
      c: 1000.0     # silicate (mgC/m**3)

  nh4:
    long_name: ammonium
    model: nersc/ecosmo_nutrient
    initialization:
      c: 8.0     # ammonium (mgC/m**3)

  oxy:
    long_name: oxygen
    model: nersc/ecosmo_oxygen
    initialization:
      c: 300 # oxygen mmol/m3
    coupling:
      no3: no3/c
      nh4: nh4/c
      alk: co2/TA

  det:
    long_name: detritus
    model: nersc/ecosmo_organic_matter
    initialization:
      c: 0.1     # detritus (mgC/m**3)
    parameters:
      remin: 0.003 # Detritus remineralization rate  (1/d)
      OMsink: 5.0 # Detritus sinking rate  (m/d)
    coupling:
      no3: no3/c
      nh4: nh4/c
      pho: pho/c
      oxy: oxy/c
      dic: co2/c
      alk: co2/TA

  dom:
    long_name: dissolved organic matter
    model: nersc/ecosmo_organic_matter
    initialization:
      c: 0.1     # dom (mgC/m**3)
    parameters:
      remin: 0.03 # DOM remineralization rate  (1/d) (10 times that of detritus)
    coupling:
      no3: no3/c
      nh4: nh4/c
      pho: pho/c
      oxy: oxy/c
      dic: co2/c
      alk: co2/TA

  opal:
    long_name: opal
    model: nersc/ecosmo_opal
    initialization:
      c: 0.1 # opal (mgC/m**3)
    parameters:
      regenSi: 0.015    # Si regeneration rate (1/d)
      OMsink: 5.0 # Opal sinking rate  (m/d)
    coupling:
      sil: sil/c

  fla:
    long_name: flagellates
    model: nersc/ecosmo_phy
    parameters:
      mu: 0.6
      m: 0.04
      m2: 0.275
      Km2: 750.0 #275.0
      rNH4: 0.20
      rNO3: 0.50
      rPO4: 0.05
      Psink: 0.0
      MINchl2nP: 0.265
      MAXchl2nP: 2.65
      alfaP: 0.0393
      psi: 3.00
    coupling:
      no3: no3/c
      nh4: nh4/c
      pho: pho/c
      oxy: oxy/c
      det: det/c
      dom: dom/c
      alk: co2/TA
      dic: co2/c
      opal: opal/c # is not used by flagellates but is kept here for code consistency
    initialization:
      c: 0.1 # mgC/m3 
      chl: 0.005 # mgChl/m3 

  dia:
    long_name: diatoms
    model: nersc/ecosmo_phy
    parameters:
      is_diatom: true
      mu: 0.7
      m: 0.04
      m2: 0.275
      Km2: 750.0 #275.0
      rNH4: 0.20
      rNO3: 0.50
      rPO4: 0.05
      rSi: 0.5
      Psink: 0.5
      MINchl2nP: 0.265
      MAXchl2nP: 2.65
      alfaP: 0.0531
      psi: 3.00
    coupling:
      no3: no3/c
      nh4: nh4/c
      pho: pho/c
      sil: sil/c
      oxy: oxy/c
      det: det/c
      dom: dom/c
      alk: co2/TA
      dic: co2/c
      opal: opal/c
    initialization:
      c: 0.1 # mgC/m3 
      chl: 0.005 # mgChl/m3

  ccl:
    long_name: coccolithophores
    model: nersc/ecosmo_phy
    parameters:
      mu: 0.6
      m: 0.04
      m2: 0.275
      Km2: 750.0 #275.0
      rNH4: 0.20
      rNO3: 1.00
      rPO4: 0.0015
      Psink: 1.5
      MINchl2nP: 0.265
      MAXchl2nP: 2.65
      alfaP: 0.0275
      psi: 3.00
      is_calcifier: true
    coupling:
      no3: no3/c
      nh4: nh4/c
      pho: pho/c
      oxy: oxy/c
      det: det/c
      dom: dom/c
      alk: co2/TA
      dic: co2/c
      opal: opal/c # is not used by flagellates but is kept here for code consistency
      caco3: caco3/c
    initialization:
      c: 0.1 # mgC/m3 
      chl: 0.005 # mgChl/m3 

  microzoo:
    long_name: microzooplankton
    model: nersc/ecosmo_zooplankton
    parameters:
      nprey: 5     # Number of preys for this grazer
      grzP: 1.0    # grazing rate on P (1/d)
      grzZ: 0.5    # grazing rate on Z (1/d)
      grzD: 0.5     # grazing rate on Z (1/d)
      Rg: 0.45     # Zs, Zl half saturation  (mmolN/m**3)
      m: 0.04      # Zooplankton mortality rate  (1/d)
      m2: 0.1
      Km2: 250.0 #275.0
      exc: 0.08    # Zooplankton excretion rate  (1/d)
      gammaP: 0.75  # Zooplankton assimilation efficiency on food  (-)
      gammaZ: 0.75  # Zooplankton assimilation efficiency on food  (-)
      gammaD: 0.3  # Zooplankton assimilation efficiency on food  (-)
      pref1: 0.65
      pref2: 0.2
      pref3: 0.1
      pref4: 0.05
      pref5: 0.0
      prey2_is_diatom: true
      prey3_is_calcifier: true
      prey4_is_detritus: true
      prey5_is_zoo: true
    coupling:
      prey1c: fla/c
      prey2c: dia/c
      prey3c: ccl/c
      prey1chl: fla/chl
      prey2chl: dia/chl
      prey3chl: ccl/chl
      prey4c: det/c
      prey5c: microzoo/c # cannibalism (default: false; i.e. pref4 = 0.0)
      nh4: nh4/c
      pho: pho/c
      oxy: oxy/c
      det: det/c
      dom: dom/c
      dic: co2/c
      alk: co2/TA
      opal: opal/c
      caco3: caco3/c
      pcal: calcite_production
    initialization:
      c: 0.01 # mgC/m3

  mesozoo:
    long_name: mesozooplankton
    model: nersc/ecosmo_zooplankton
    parameters:
      nprey: 6     # Number of preys for this grazer
      grzP: 1.0     # grazing rate on P (1/d)
      grzZ: 0.5     # grazing rate on Z (1/d)
      grzD: 0.5     # grazing rate on Z (1/d)
      Rg: 0.45     # Zs, Zl half saturation  (mmolN/m**3)
      m: 0.04      # Zooplankton mortality rate  (1/d)
      m2: 0.1
      Km2: 250.0 #275.0
      exc: 0.08    # Zooplankton excretion rate  (1/d)
      gammaP: 0.75  # Zooplankton assimilation efficiency on food  (-)
      gammaZ: 0.75  # Zooplankton assimilation efficiency on food  (-)
      gammaD: 0.3  # Zooplankton assimilation efficiency on food  (-)
      pref1: 0.07
      pref2: 0.55
      pref3: 0.2
      pref4: 0.07
      pref5: 0.11
      pref6: 0.0
      prey2_is_diatom: true
      prey3_is_calcifier: true
      prey4_is_detritus: true
      prey5_is_zoo: true
      prey6_is_zoo: true
    coupling:
      prey1c: fla/c
      prey2c: dia/c
      prey3c: ccl/c
      prey1chl: fla/chl
      prey2chl: dia/chl
      prey3chl: ccl/chl
      prey4c: det/c
      prey5c: microzoo/c
      prey6c: mesozoo/c # cannibalism (default: false; i.e. pref5 = 0.0)
      nh4: nh4/c
      pho: pho/c
      oxy: oxy/c
      det: det/c
      dom: dom/c
      dic: co2/c
      alk: co2/TA
      opal: opal/c
      caco3: caco3/c
      pcal: calcite_production
    initialization:
      c: 0.01 # mgC/m3

  caco3:
    long_name: calcium_carbonate
    model: nersc/ecosmo_caco3
    parameters:
      IMsink: 5.0
      calcDis: 0.03
    coupling:
      dic: co2/c
      alk: co2/TA
      Om_cal_target: co2_Om_cal
    initialization:
      c: 0.001

  sed:
    long_name: sediment
    model: nersc/ecosmo_sediment
    parameters:
      resuspRt: 25.00
      sedimRt: 5.0
      burialRt: 0.00005
      reminSED: 0.001
      TctrlDenit: 0.15
      RelSEDp1: 0.15
      RelSEDp2: 0.1
      reminSEDsi: 0.0002
    coupling:
      no3: no3/c
      nh4: nh4/c
      pho: pho/c
      oxy: oxy/c
      det: det/c
      opal: opal/c
      dic: co2/c
      alk: co2/TA
      caco3: caco3/c
    initialization:
      sed1       : 113.6 # mgC/m2 (20mgN in C units)
      sed2       : 56.65 # mgC/m2 (20mgSi in C units)
      sed3       : 82.2  # mgC/m2 (2mgP in C units)
      sed4       : 0.12  # mgC/m2 (CAGLAR : no idea what the value should be)
